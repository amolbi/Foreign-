package com.new.example.security.tool;

import com.new.example.security.AesKeyProvider;
import com.new.example.security.Aes256GcmEncryptionService;

public class CredentialEncryptionTool {

    public static void main(String[] args)
            throws Exception {

        if (args.length != 2) {

            System.out.println(
                    "Usage: CredentialEncryptionTool "
                    + "<key-file> <plain-text>");

            System.exit(1);
        }

        String keyFile = args[0];

        String plainText = args[1];

        AesKeyProvider keyProvider =
                new AesKeyProvider(keyFile);

        Aes256GcmEncryptionService service =
                new Aes256GcmEncryptionService(
                        keyProvider);

        String encrypted =
                service.encrypt(plainText);

        System.out.println(encrypted);
    }
}
